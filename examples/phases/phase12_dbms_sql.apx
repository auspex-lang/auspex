// Phase 12 Task 4: dbms_sql cursor API demonstration.
//
// This example runs with the default custom engine using parameterless SQL.
// To exercise positional binds (?1, ?2, ...), run it against SQLite:
//   ./bin/auspex examples/phase12_dbms_sql.apx --db /tmp/demo.db
// The custom engine ignores ?var placeholders, so parameterless SQL is used
// below for portability.

proc main() -> int {
    create table demo_employees (id int, name string, dept string);

    // Parameterless DML works on both engines.
    int c = dbms_sql.open_cursor();
    dbms_sql.parse(c, "insert into demo_employees values (1, 'alice', 'eng')");
    int inserted = dbms_sql.execute_cursor(c);
    print inserted;

    dbms_sql.parse(c, "insert into demo_employees values (2, 'bob', 'sales')");
    inserted = dbms_sql.execute_cursor(c);
    print inserted;

    // SELECT through the cursor.
    dbms_sql.parse(c, "select id, name, dept from demo_employees order by id");
    int select_rc = dbms_sql.execute_cursor(c);
    print select_rc;  // 0 for SELECT

    array<row> rows = dbms_sql.fetch_rows(c, 10);
    print length(rows);

    for emp in rows {
        print emp.id;
        print emp.name;
        print emp.dept;
    }

    // Demonstrate column_value on the current row (the last row fetched).
    any last_id = dbms_sql.column_value(c, 0);
    any last_name = dbms_sql.column_value(c, 1);
    print last_id;
    print last_name;

    dbms_sql.close_cursor(c);

    // Bind example for SQLite only:
    // int c2 = dbms_sql.open_cursor();
    // dbms_sql.parse(c2, "insert into demo_employees values (?1, ?2, ?3)");
    // dbms_sql.bind_variable(c2, "1", 3);
    // dbms_sql.bind_variable(c2, "2", "carol");
    // dbms_sql.bind_variable(c2, "3", "eng");
    // dbms_sql.execute_cursor(c2);
    // dbms_sql.close_cursor(c2);

    return 0;
}
