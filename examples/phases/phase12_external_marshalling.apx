// Phase 12: external_call float/string marshalling example.
// Auspex int, float and string arguments are passed as C int, double and
// const char*. The native name selects the C return type:
//   external_call        -> int
//   external_call_float  -> float
//   external_call_string -> string (copied; a NULL char* becomes NULL)
// The built-in PLATFORM_* flags pick where the C and math libraries live.
proc main() -> int {
$if PLATFORM_WINDOWS $then
    string libc = "msvcrt.dll";
    string libm = "msvcrt.dll";
$elsif PLATFORM_MACOS $then
    string libc = "/usr/lib/libSystem.B.dylib";
    string libm = "/usr/lib/libSystem.B.dylib";
$else
    string libc = "libc.so.6";
    string libm = "libm.so.6";
$end
    int n = external_call(libc, "strlen", "marshalling");
    print int_to_string(n);

    float root = external_call_float(libm, "sqrt", 2.0);
    print float_to_string(root);

    string shell = external_call_string(libc, "getenv", "AUSPEX_UNSET_VARIABLE");
    print nvl(shell, "(not set)");
    return 0;
}
