// Phase 12: trigger persistence, DROP TRIGGER, and triggers on dynamic SQL.
//
// Trigger declarations are persisted as program units (the <db>.programs
// sidecar for the custom engine, the _auspex_program_units table on SQLite),
// so a trigger created in one process keeps firing in later ones until it is
// dropped with `drop trigger <name>;`.
//
// Note: the typechecker cannot resolve row fields for a table created and
// selected in the same file, so this example uses prints instead of a
// for-row select loop over audit_log.

trigger audit_insert after insert on audit_log {
    print "trigger fired: insert into audit_log";
}

proc main() -> int {
    create table audit_log (id int);

    // Static SQL: fires (compile-time trigger call).
    insert into audit_log values (1);

    // Dynamic SQL: also fires (runtime trigger registry).
    execute_immediate("insert into audit_log values (2)");

    // Drop stops the trigger immediately and persists the removal.
    drop trigger audit_insert;
    insert into audit_log values (3);                          // silent
    execute_immediate("insert into audit_log values (4)");     // silent

    int n = 0;
    select count(*) into n from audit_log;
    print n;  // 4 rows: all inserts ran, the trigger only fired twice
    return 0;
}
