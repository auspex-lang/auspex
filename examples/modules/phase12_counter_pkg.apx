// Helper module for phase12_import_packages.apx — a package with
// package-level state declared in an imported module. Before Phase 12 the
// initializer (counter = 41) never ran for imported modules, so get()
// returned the zero value instead of 41.
//
// Not a standalone program: it lives in examples/modules/ so the examples
// runner (which globs only examples/*.apx) doesn't try to execute it.
package counter is
    counter int;
    func get() -> int;
    func bump() -> int;
end counter;

package body counter is
    int counter = 41;
    func get() -> int {
        return counter;
    }
    func bump() -> int {
        counter = counter + 1;
        return counter;
    }
end counter;
